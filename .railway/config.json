{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "services": {
    "backend": {
      "path": "./backend",
      "startCommand": "npm run start:prod",
      "healthcheckPath": "/health"
    },
    "frontend": {
      "path": "./frontend",
      "startCommand": "npm run preview",
      "healthcheckPath": "/"
    }
  }
}
